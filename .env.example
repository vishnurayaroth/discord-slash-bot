# Names only. Copy to .env (git-ignored) and fill in real values. Never commit real values.

# Discord application id: builds Discord API and invite addresses
DISCORD_APPLICATION_ID=
# Discord application public key (hex): verifies request signatures
DISCORD_PUBLIC_KEY=
# Discord bot token: authorizes bot calls
DISCORD_BOT_TOKEN=
# Second-channel destination (a Discord channel webhook address). Secret.
MIRROR_WEBHOOK_URL=
# JDBC address of the Neon DIRECT endpoint with sslmode=require and channelBinding=require. No credentials in it.
DATABASE_URL=
# Database credentials
DB_USER=
DB_PASSWORD=
# The single admin's sign-in name
ADMIN_USERNAME=
# BCrypt hash of the admin password (never the password itself)
ADMIN_PASSWORD_HASH=
# Port the platform expects the app on (set to 8080 on Render)
PORT=
